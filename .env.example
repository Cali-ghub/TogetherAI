# Template only. Never use as production credentials or commit a populated .env.
# scripts/set-local-secrets.sh creates a separate mode-0600 environment file.
TOGETHER_SESSION_SECRET=
TOGETHER_USER_1_USERNAME=member1
TOGETHER_USER_1_DISPLAY_NAME=Participant 1
TOGETHER_USER_1_PASSWORD=
TOGETHER_USER_2_USERNAME=member2
TOGETHER_USER_2_DISPLAY_NAME=Participant 2
TOGETHER_USER_2_PASSWORD=
TOGETHER_COOKIE_SECURE=true
TOGETHER_DEFAULT_ROOM_TITLE=Shared conversation
TOGETHER_DB_PATH=.runtime/together.db
